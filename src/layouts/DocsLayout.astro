---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  fullBleed?: boolean;  // true on /examples/* and /
}
const { title, description = 'Declarative form validation in HTML — for server-rendered apps, HTMX/Alpine, and no-build static sites.', fullBleed = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    {/* Theme bootstrap script — runs before paint to prevent flash */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <Header>
      <slot name="theme-toggle" slot="theme-toggle" />
    </Header>
    <main id="main" class:list={[fullBleed ? 'main-full' : 'main-prose']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .main-full {
    /* Examples and the home hero use the full-bleed container in their own components */
  }
  .main-prose {
    /* Match .container-wide so reference pages (/validators/, /api/) feel
       continuous with the full-bleed home/example pages. Long-form prose
       stays readable via the global p, li { max-width: var(--content-max) }
       rule; tables, code blocks, and validator cards get the extra room. */
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-6) var(--gutter-mobile);
  }
  @media (min-width: 768px) {
    .main-prose {
      padding-left: var(--gutter-desktop);
      padding-right: var(--gutter-desktop);
    }
  }
</style>
