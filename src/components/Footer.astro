---
import { libVersion } from '~/lib/lib-version';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container-wide footer-inner">
    <p class="muted">
      <code>@form-validator-js/{`{core,validators}`}</code> v{libVersion} · MIT · by
      <a href="https://github.com/mellonis">mellonis</a>
    </p>
    <p class="muted">© {year}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: var(--space-8);
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    font-size: 0.875rem;
    flex-wrap: wrap;
  }
  .footer-inner p { margin: 0; }
  .footer-inner code { font-size: 0.875rem; }
</style>
