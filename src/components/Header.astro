---
const navItems = [
  { href: '/validators/', label: 'Validators', section: 'validators' },
  { href: '/examples/', label: 'Examples', section: 'examples' },
  { href: '/api/', label: 'API', section: 'api' },
];
const currentSection = Astro.url.pathname.split('/')[1] ?? '';
---
<header class="site-header">
  <a href="#main" class="skip-link">Skip to content</a>
  <div class="container-wide header-inner">
    <a href="/" class="brand">form-validator-js</a>
    <nav aria-label="Primary">
      <ul>
        {navItems.map(({ href, label, section }) => (
          <li>
            <a href={href} class:list={[
              'nav-link',
              currentSection === section ? 'is-current' : '',
            ]}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <a href="https://github.com/mellonis/form-validator-js" class="github-link" aria-label="GitHub repository">GitHub ↗</a>
      <slot name="theme-toggle" />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    backdrop-filter: blur(8px);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    flex-wrap: wrap;
    row-gap: 8px;
  }
  .brand {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
    letter-spacing: -0.01em;
    white-space: nowrap;
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .brand { font-size: 0.875rem; }
  }
  nav ul {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nav-link {
    color: var(--fg);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .nav-link:hover, .nav-link.is-current {
    color: var(--accent);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .github-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg);
    text-decoration: none;
  }
  .github-link:hover { color: var(--accent); }

  @media (max-width: 640px) {
    nav ul { gap: var(--space-2); }
    .github-link { display: none; }
  }
</style>
